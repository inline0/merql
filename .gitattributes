# Composer installs this package from the tag's GitHub archive, which is
# built with `git archive` and honours `export-ignore`. Everything listed here
# is development-only, so consumers never download it.

/.github              export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/CLAUDE.md            export-ignore
/docs                 export-ignore
/phpcs.xml            export-ignore
/phpstan.neon         export-ignore
/phpunit.xml.dist     export-ignore
/scenarios            export-ignore
/scripts              export-ignore
/tests                export-ignore

# Development scripts in bin/ stay out. bin/merql is the binary declared in
# composer.json, so it ships.
/bin/*                export-ignore
/bin/merql            -export-ignore
